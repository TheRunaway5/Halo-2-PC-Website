# Private master-only configuration; never ship these credentials to clients.
H2_EOS_PRODUCT_ID=REPLACE_WITH_EXISTING_PRODUCT_ID
H2_EOS_SANDBOX_ID=REPLACE_WITH_EXISTING_SANDBOX_ID
H2_EOS_DEPLOYMENT_ID=REPLACE_WITH_EXISTING_DEPLOYMENT_ID
H2_EOS_FRIEND_CLIENT_ID=REPLACE_WITH_DEDICATED_STORAGE_CLIENT_ID
H2_EOS_FRIEND_CLIENT_SECRET=REPLACE_WITH_PRIVATE_STORAGE_CLIENT_SECRET
H2_EOS_FRIEND_CACHE_DIR=/run/halo2-friends
# Generate 32 cryptographically random bytes, encoded as exactly 64 hex digits.
# Preserve the key in private backups; do not regenerate on service restart.
H2_EOS_FRIEND_ENCRYPTION_KEY=REPLACE_WITH_PRIVATE_64_HEX_KEY
